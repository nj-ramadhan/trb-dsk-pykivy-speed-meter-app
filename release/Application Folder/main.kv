#:kivy 2.1.0

#:import NoTransition kivy.uix.screenmanager.NoTransition
#:include screen_home.kv
#:include screen_login.kv
#:include screen_main.kv
#:include screen_menu.kv
#:include screen_add_data.kv
#:include screen_add_queue.kv
#:include screen_calibration.kv
#:include screen_speed_meter.kv
#:include screen_sideslip_meter.kv

# ScreenManager:
<RootScreen>:
    id: screen_manager
    transition: NoTransition()

    ScreenHome:
        id: screen_home
        name: 'screen_home'
        screen_manager: screen_manager

    ScreenLogin:
        id: screen_login
        name: 'screen_login'
        screen_manager: screen_manager

    ScreenMain:
        id: screen_main
        name: 'screen_main'
        screen_manager: screen_manager
        
    ScreenMenu:
        id: screen_menu
        name: 'screen_menu'
        screen_manager: screen_manager

    ScreenAddData:
        id: screen_add_data
        name: 'screen_add_data'
        screen_manager: screen_manager

    ScreenAddQueue:
        id: screen_add_queue
        name: 'screen_add_queue'
        screen_manager: screen_manager

    ScreenCalibration:
        id: screen_calibration
        name: 'screen_calibration'
        screen_manager: screen_manager

    ScreenSpeedMeter:
        id: screen_speed_meter
        name: 'screen_speed_meter'
        screen_manager: screen_manager   

    ScreenSideSlipMeter:
        id: screen_sideslip_meter
        name: 'screen_sideslip_meter'
        screen_manager: screen_manager   
